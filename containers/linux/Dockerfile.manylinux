ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64:2026.10.16-1@sha256:1e7b8460ad8fb3fb0fbe1cd818845159ac896b4fd17452d56e892c291f3b97a8
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/WizzyGeek/pyo3dCBOR"

ARG RUST_VERSION=1.90.0
ARG RUST_TARGET
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_INIT_SHA256=17247e4bcacf6027ec2e11c79a72c494c9af69ac8d1abcc1b271fa4375a106c2

ENV RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    CARGO_BUILD_JOBS=2 \
    RUSTUP_TOOLCHAIN=${RUST_VERSION} \
    PATH=/root/.cargo/bin:${PATH}

RUN set -eu; \
    test -n "${RUST_TARGET}"; \
    curl --proto '=https' --tlsv1.2 -sSf "https://raw.githubusercontent.com/rust-lang/rustup/${RUSTUP_VERSION}/rustup-init.sh" \
      -o /root/rustup-init.sh; \
    echo "${RUSTUP_INIT_SHA256}  /root/rustup-init.sh" | sha256sum -c -; \
    RUSTUP_VERSION="${RUSTUP_VERSION}" sh /root/rustup-init.sh -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}"; \
    rm /root/rustup-init.sh; \
    rustup target add "${RUST_TARGET}" --toolchain "${RUST_VERSION}"; \
    rustc --version | grep -Eq "^rustc ${RUST_VERSION}([[:space:]]|$)"
