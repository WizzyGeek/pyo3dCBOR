+#[test]
+fn negative_int_coerced_to_float_exactly() {
+    assert_eq!(f32::try_from(CBOR::from(-1i64)).unwrap(), -1.0);
+    assert_eq!(f32::try_from(CBOR::from(-2i64)).unwrap(), -2.0);
+    assert_eq!(f32::try_from(CBOR::from(-17i64)).unwrap(), -17.0);
+
+    // Immediately above the binary32 consecutive-integer range, only even
+    // integers remain exactly representable.
+    assert!(f32::try_from(CBOR::from(-16_777_217i64)).is_err());
+    assert_eq!(
+        f32::try_from(CBOR::from(-16_777_218i64)).unwrap(),
+        -16_777_218.0
+    );
+
+    // The encoded magnitude of this value is 2^53 + 1, which is not exactly
+    // representable as binary64; the represented signed integer 2^53 + 2 is.
+    assert!(f64::try_from(CBOR::from(-9_007_199_254_740_993i64)).is_err());
+    assert_eq!(
+        f64::try_from(CBOR::from(-9_007_199_254_740_994i64)).unwrap(),
+        -9_007_199_254_740_994.0
+    );
+
+    // The full explicit negative-integer range includes -2^64, which is exact
+    // in both binary32 and binary64 even though its major-type-1 argument is
+    // u64::MAX.
+    let negative_two_to_64 = CBOR::try_from_hex("3bffffffffffffffff").unwrap();
+    assert_eq!(
+        f32::try_from(negative_two_to_64.clone()).unwrap(),
+        -18_446_744_073_709_551_616.0
+    );
+    assert_eq!(
+        f64::try_from(negative_two_to_64).unwrap(),
+        -18_446_744_073_709_551_616.0
+    );
 }
 
