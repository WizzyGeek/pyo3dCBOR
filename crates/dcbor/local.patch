+fn encode_ascii_and_normalized_non_ascii_strings() {
+    assert_eq!(CBOR::from("").to_cbor_data(), hex!("60"));
+    assert_eq!(CBOR::from("A\0\u{7f}").to_cbor_data(), hex!("6341007f"));
+    assert_eq!(
+        CBOR::from("abcdefghijklmnopqrstuvwx").to_cbor_data(),
+        hex!("78186162636465666768696a6b6c6d6e6f707172737475767778")
+    );
+
+    // Non-ASCII strings still use NFC. The first contracts to U+00E9;
+    // U+0344 expands to U+0308 followed by U+0301.
+    assert_eq!(CBOR::from("e\u{301}").to_cbor_data(), hex!("62c3a9"));
+    assert_eq!(CBOR::from("\u{344}").to_cbor_data(), hex!("64cc88cc81"));
+}
