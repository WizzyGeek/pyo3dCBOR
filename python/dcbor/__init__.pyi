from typing import Any, Iterable, Iterator

class CBORError(Exception): ...

class CBORTag:
    tag: int
    value: Any
    def __init__(self, tag: int, value: Any) -> None: ...

class CBORMap:
    """Immutable CBOR snapshot with canonical encoded-key identity.

    Keys/values returned by accessors are fresh decoded snapshots.
    """
    def __init__(self, pairs: Iterable[Iterable[Any]]) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __contains__(self, key: Any) -> bool: ...
    def __iter__(self) -> Iterator[Any]: ...
    def keys(self) -> list[Any]: ...
    def values(self) -> list[Any]: ...
    def items(self) -> list[tuple[Any, Any]]: ...
    def get(self, key: Any, default: Any = None) -> Any: ...

def dumps(obj: Any) -> bytes: ...
def loads(data: bytes) -> Any: ...
def diagnostic(data: bytes) -> str: ...
def diagnostic_flat(data: bytes) -> str: ...
def validate(data: bytes) -> int: ...

__version__: str
